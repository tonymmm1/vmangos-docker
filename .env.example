# Public game endpoints. Set VMANGOS_REALM_ADDRESS to the address or DNS name
# that game clients can reach. MariaDB is not published by the base stack.
TZ=Etc/UTC
VMANGOS_PUBLIC_BIND_ADDRESS=0.0.0.0
VMANGOS_REALMD_PORT=3724
VMANGOS_REALM_ADDRESS=127.0.0.1
VMANGOS_REALM_PORT=8085
VMANGOS_REALM_NAME=VMaNGOS

# Realm metadata.
VMANGOS_REALM_ID=1
VMANGOS_REALM_ICON=1
VMANGOS_REALM_FLAGS=0
VMANGOS_REALM_TIMEZONE=1
VMANGOS_REALM_SECURITY_LEVEL=0
VMANGOS_REALM_POPULATION=0
VMANGOS_CLIENT_BUILD=5875
VMANGOS_REALM_FLAG=2
VMANGOS_ANTICHEAT=1

# Internal database connection settings. Change these only when using an
# external database server.
VMANGOS_DB_HOST=vmangos_database
VMANGOS_DB_PORT=3306
VMANGOS_DB_USER=mangos

# Optional host-only database administration settings used by
# docker-compose.admin.yml.
VMANGOS_DB_BIND_ADDRESS=127.0.0.1
VMANGOS_DB_PUBLISHED_PORT=3306
VMANGOS_SECRETS_DIR=./secrets
